{
  "name": "cow-farming",
  "version": "0.1.0",
  "private": true,
  "description": "Farm Friends: a farm animals & tractors game for kids on iPhone. Become any cow, dog, horse, or tractor!",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/icons.mjs",
    "build:pages": "BASE_PATH=/cow-farming/ npm run build",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "playwright": "1.55.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  }
}
